{
  "name": "nova-measured",
  "version": "0.1.0",
  "description": "Measured by Nova: local spatial reconstruction framework for physically accurate Blender models from measurements, structured photos, and materials.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/kristoffersodersten/measured-by-nova#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kristoffersodersten/measured-by-nova.git"
  },
  "bugs": {
    "url": "https://github.com/kristoffersodersten/measured-by-nova/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "blender",
    "llm-agnostic",
    "spatial-reconstruction",
    "photogrammetry",
    "pbr",
    "measured-visualization",
    "3d",
    "2d",
    "typescript",
    "local-first"
  ],
  "bin": {
    "nova-measured": "dist/src/server.js",
    "codex-blender-mcp": "dist/src/server.js"
  },
  "files": [
    "dist",
    "blender",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "audit:security": "pnpm audit --audit-level high",
    "benchmark": "node dist/scripts/run-performance-benchmark.js",
    "benchmark:xray": "node --cpu-prof --cpu-prof-dir=evidence --cpu-prof-name=performance.cpuprofile dist/scripts/run-performance-benchmark.js",
    "build": "tsc -p tsconfig.json && mkdir -p dist/blender && cp blender/*.py dist/blender/",
    "dev": "tsx src/server.ts",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --exclude tests/goldenManifest.integration.test.ts",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.15.2",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.25.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
